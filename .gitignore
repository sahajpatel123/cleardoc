# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Local agent state
.claude/
.openclaude/
.antigravitycli/
.opencode/

# Build / dependency artifacts
node_modules/
.next/
.vercel/
dist/
build/
out/

# Test artifacts
playwright-report/
test-results/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files — never commit secrets. Commit .env.example instead.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.vercel*
# But keep any committed example/template files
!*.env.example
!.env.example

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Vercel project link state (generated on first `vercel link`)
.vercel/project.json

# Design concepts (working files — promoted to root when adopted)
# design-concepts/

# Memory system (shared memory lives in repo; backups in memory/ are kept,
# but daily scratch should not accumulate here)
# memory/daily/
