{
  "name": "ClearDoc",
  "short_name": "ClearDoc",
  "description": "Read what you're about to sign. ClearDoc turns intimidating documents into plain English.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf7ee",
